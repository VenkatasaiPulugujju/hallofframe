rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'venkatasaipulugju@gmail.com' ||
          request.auth.token.email.matches('(?i)^admin.*@cvv\\.ac\\.in$')
        )) ||
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAuthorizedUser() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{uid} {
      allow get: if isAuthorizedUser();
      allow list: if isAdmin();
      
      // User can create and maintain their profile
      allow create: if isAuthorizedUser() && isOwner(uid) && isValidId(uid);
      allow update: if isAuthorizedUser() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Admins Collection ---
    match /admins/{uid} {
      allow read: if isAuthorizedUser();
      allow write: if isAdmin();
    }

    // --- Posts Collection ---
    function isValidPost(data) {
      return data.postId is string && isValidId(data.postId)
        && data.authorUid is string && data.authorUid == request.auth.uid
        && data.authorDisplayName is string && data.authorDisplayName.size() <= 120
        && data.caption is string && data.caption.size() >= 3 && data.caption.size() <= 280
        && data.category is string
        && data.consentConfirmed == true;
    }

    match /posts/{postId} {
      // Approved posts are readable by anyone signed in
      // Pending/rejected posts are readable by author or admin
      allow get: if isAuthorizedUser() && (
        resource.data.status == 'approved' ||
        resource.data.authorUid == request.auth.uid ||
        isAdmin()
      );

      // List query security: must be signed in
      allow list: if isAuthorizedUser();

      // Student/User creates a new post in pending OR approved status
      allow create: if isAuthorizedUser()
        && isValidId(postId)
        && incoming().postId == postId
        && isValidPost(incoming())
        && (incoming().status == 'pending' || incoming().status == 'approved');

      // Post update:
      // Case 1: Admin moderation (approve, reject, remove)
      // Case 2: Author soft-deleting/requesting removal of their own post
      // Case 3: Counter update (reaction increments atomic batch)
      // Case 4: Flagging / report count increment
      allow update: if isAuthorizedUser() && (
        // Admin can moderate any post
        isAdmin() ||
        // Author can mark their post as 'removed'
        (resource.data.authorUid == request.auth.uid && incoming().status == 'removed') ||
        // Verified users reacting: reactionCounts and updatedAt
        (resource.data.status == 'approved' && incoming().diff(existing()).affectedKeys().hasOnly(['reactionCounts', 'updatedAt'])) ||
        // Verified users reporting: reportCount and updatedAt
        (resource.data.status == 'approved' && incoming().diff(existing()).affectedKeys().hasOnly(['reportCount', 'updatedAt']))
      );

      // Authors can delete their own pending post; Admins can delete any post
      allow delete: if (isAuthorizedUser() && resource.data.authorUid == request.auth.uid && resource.data.status == 'pending')
        || isAdmin();

      // --- Post Reactions Subcollection ---
      // One reaction per user per post: document ID is request.auth.uid
      match /reactions/{uid} {
        allow read: if isAuthorizedUser();
        allow create, update: if isAuthorizedUser() && isOwner(uid) && isValidId(uid);
        allow delete: if isAuthorizedUser() && isOwner(uid);
      }
    }

    // --- Reports Collection ---
    match /reports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();

      // Any signed in student can submit a report
      allow create: if isAuthorizedUser()
        && isValidId(reportId)
        && incoming().reportId == reportId
        && incoming().reporterUid == request.auth.uid
        && incoming().status == 'pending';

      // Only admins can review or resolve reports
      allow update, delete: if isAdmin();
    }

    // --- Moderation Logs Collection ---
    match /moderationLogs/{logId} {
      // Strictly admin-only audit trail
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidId(logId)
        && incoming().logId == logId
        && incoming().moderatorUid == request.auth.uid;
      allow update, delete: if false; // Logs are immutable
    }
  }
}
