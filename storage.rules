rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedCvv() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@cvv[.]ac[.]in$');
    }

    function isAdmin() {
      return isVerifiedCvv() && (
        request.auth.token.admin == true
      );
    }

    // Images stored under post-images/{uid}/{postId}/{filename}
    match /post-images/{uid}/{postId}/{filename} {
      // Verified users can read post images
      allow read: if isVerifiedCvv();

      // Only the author can upload their own post image
      allow write: if isVerifiedCvv()
        && request.auth.uid == uid
        // Size limit: 5MB maximum
        && request.resource.size <= 5 * 1024 * 1024
        // Allowed image MIME types only
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // Author or admin can delete the file during moderation or post removal
      allow delete: if (isVerifiedCvv() && request.auth.uid == uid) || isAdmin();
    }
  }
}
